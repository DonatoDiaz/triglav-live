# Triglav Live build configuration.
# Copy to config.env (gitignored) and edit.

ISO_NAME="triglav-live"
ISO_LABEL="TRIGLAV_LIVE"
ISO_VERSION="0.1.0"
ISO_PUBLISHER="Triglav Labs"
ISO_APPLICATION="Triglav Live — rescue and repair environment"

# Embed TriglavCode into the ISO (recommended: works offline).
EMBED_TRIGLAVCODE=1
TRIGLAVCODE_REPO="DonatoDiaz/triglavcode"
# "latest" or a release tag such as v1.19.0-triglav.1
TRIGLAVCODE_TAG="latest"
# Optional: local path or URL to a triglavcode-*-linux-x64.tar.gz.
# Takes precedence over TRIGLAVCODE_TAG.
TRIGLAVCODE_TARBALL_URL=""

# squashfs compression: xz (smaller, slower) or zstd (faster, bigger)
AIROOTFS_COMPRESSION="xz"

OUT_DIR="out"
